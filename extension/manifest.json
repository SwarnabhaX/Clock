{
  "manifest_version": 3,
  "name": "Cookie Scanner",
  "version": "1.0",
  "description": "Scans cookies and sends them to a server.",
  "permissions": [
    "cookies",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
